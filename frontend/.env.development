# Loaded automatically by `npm run dev:web` (Vite development mode). Committed on purpose: local,
# non-secret settings only. Override per machine in .env.development.local (gitignored).

# Dev server only (not exposed to the browser): where /api and /uploads are proxied.
# Must match the backend's PORT in backend/config/config.env.
DEV_API_TARGET=http://localhost:4000
