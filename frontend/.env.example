# Copy to .env.local to override. Only VITE_* values reach the browser — never put secrets here.

# API base path; /api is proxied to the backend in dev and rewritten by Vercel in production
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=LearnHub

# Dev server only (not exposed to the browser): where `npm run dev:web` proxies /api and /uploads.
# Defaults to http://localhost:4000; change it if the backend PORT differs.
# DEV_API_TARGET=http://localhost:4000
