{
  "name": "learnhub",
  "version": "1.0.0",
  "private": true,
  "description": "LearnHub, an academy directory website",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "start:api": "npm start -w backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check --workspaces --if-present && npm run format:check",
    "seed:i": "npm run seed:i -w backend",
    "seed:d": "npm run seed:d -w backend",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardik6869/DevCamper.git"
  },
  "author": "Hardik Sorathiya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hardik6869/DevCamper/issues"
  },
  "homepage": "https://github.com/hardik6869/DevCamper#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,mjs,json,md,yml,yaml}": "prettier --write"
  }
}
