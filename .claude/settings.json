{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./backend/config/config.env)",
      "Edit(./backend/config/config.env)",
      "Bash(cat backend/config/config.env)",
      "Bash(git push --force:*)"
    ]
  }
}
