NODE_ENV=development
PORT=4000

# Frontend origin: allowed by CORS and used for links in emails
CLIENT_URL=http://localhost:5173

# Number of proxies in front of the API in production (Vercel + Render = 2); leave empty locally
TRUST_PROXY=

# Required
MONGO_URI=

FILE_UPLOAD_PATH=./public/uploads
MAX_FILE_UPLOAD=1000000
# cloudinary://<api_key>:<api_secret>@<cloud_name>; empty = save photos to FILE_UPLOAD_PATH
CLOUDINARY_URL=

# Required. Names are case-sensitive on Linux (Render): use exactly these spellings
JWT_SECRET=
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=
FROM_EMAIL=
